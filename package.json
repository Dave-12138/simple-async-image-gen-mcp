{
  "name": "siliconflow-image-gen-mcp",
  "version": "0.1.0",
  "description": "通过硅基流动 API 异步生成图片的 MCP 服务器",
  "type": "module",
  "bin": {
    "siliconflow-image-gen-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run typecheck && vite build",
    "dev": "npm run build && node dist/index.js",
    "watch": "vite build --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --import tsx --test test/config.test.mjs test/integration.test.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^26.6.6",
    "tsx": "^4.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
